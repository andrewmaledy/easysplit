{
  "name": "easysplit",
  "main": "src/index.tsx",
  "compatibility_date": "2024-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easysplit-db",
      "database_id": "local"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "local"
    }
  ]
}
